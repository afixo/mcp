{
  "name": "afixo-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for Afixo (https://mcp.afixo.io/mcp): lets AI agents act as an Afixo requester through the machine API.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
